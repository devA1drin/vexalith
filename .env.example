# ── Database ────────────────────────────────────────────────────────────────
# Local zero-config default (SQLite). For docker-compose / Postgres:
# DATABASE_URL=postgresql://ct:ct@localhost:5432/critical_thinking
DATABASE_URL=sqlite:///./critical_thinking.db

# ── xAI Grok (OpenAI-compatible Chat Completions) ───────────────────────────
# Docs: https://docs.x.ai  |  Models: https://docs.x.ai/docs/models
# Structured JSON: response_format type json_object / json_schema
#   https://docs.x.ai/developers/model-capabilities/text/structured-outputs
#
# Get a key at https://console.x.ai — never commit real keys.
XAI_API_KEY=
# Alternative name (also accepted):
# LLM_API_KEY=

LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4.7

# ── Offline Hugging Face fallback (optional) ────────────────────────────────
HF_ENABLED=true
HF_MODEL_NAME=facebook/bart-large-mnli

# ── App ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set to 1 to generate fresh questions via Grok on GET /questions/next
LLM_GENERATE_QUESTIONS=0
