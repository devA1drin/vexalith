# Copy to backend/.env and frontend/.env.local for local development.
# Never commit real values. Generate secrets with:  openssl rand -base64 48

# ── Backend (FastAPI) ───────────────────────────────────────────────────────
# Local default is SQLite. With docker-compose / Neon use a postgresql:// URL.
DATABASE_URL=sqlite:///./vexalith.db
# Shared with the frontend; used to verify the short-lived HS256 tokens it mints.
BACKEND_JWT_SECRET=
CORS_ORIGINS=http://localhost:3000
# Optional model grader (OpenAI-compatible; xAI by default). Without a key, the
# offline rubric grader is used.
XAI_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4.7
LLM_GENERATE_QUESTIONS=0
# Who can open /admin: comma-separated provider:account_id, e.g. github:12345678.
# Empty means nobody.
ADMIN_IDENTITIES=

# ── Frontend (Next.js + Auth.js) ────────────────────────────────────────────
AUTH_SECRET=
AUTH_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# BACKEND_JWT_SECRET=   (same value as the backend's)
# OAuth apps — each provider is enabled only when both values are set.
# GitHub callback: <site>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Google callback: <site>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional: 308-redirect a legacy host to this one (production only).
# PRIMARY_HOST=vexalith-app.vercel.app
